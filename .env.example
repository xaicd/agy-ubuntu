# 复制为 .env 并填入你的订阅链接(mihomo 订阅,base64 编码的 URI 列表)
CLASH_URL=

# ===== E2E 镜像(docker-compose.e2e.yml)环境变量 =====
# 是否在 entrypoint 异步启动 Android emulator(0=不自动,1=启动)
E2E_AUTOSTART_EMULATOR=0
# AVD 名称(首次启动会自动创建)
AVD_NAME=test30
# Android system-image API 级别(google_apis x86_64)
ANDROID_API_LEVEL=30
# 完全跳过 emulator(测试 / 无 KVM 环境)
E2E_SKIP_EMULATOR=0
# 额外直连 CIDR 列表,逗号分隔,不走代理直接访问(留空=仅内置 DIRECT 规则生效)
# 适用场景:测试本地/私网部署的服务(如内网测试服、开发机)
# 例: E2E_BYPASS_CIDRS=192.144.0.0/16,100.64.0.0/10
# 或精确 IP: E2E_BYPASS_CIDRS=192.144.253.205/32,100.101.22.109/32
E2E_BYPASS_CIDRS=
